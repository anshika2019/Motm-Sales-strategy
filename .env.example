# Project Settings -> API in the Supabase dashboard
# No JWT secret needed: this backend verifies tokens against Supabase's
# public JWKS endpoint (SUPABASE_URL + /auth/v1/.well-known/jwks.json).
# This only works for projects using the newer asymmetric signing keys
# (ES256/RS256) -- a project still on the legacy HS256 shared secret won't
# publish it via JWKS (that would leak the secret), so this backend would
# need the old shared-secret verification path added back for that case.
SUPABASE_URL=https://<project-ref>.supabase.co

# Project Settings -> API -> Project API keys -> service_role
# Used server-side by POST /auth/login to call Supabase's auth API, and
# reserved for future Supabase Admin API calls. Never expose this to a
# client or return it in any API response.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings -> Database -> Connection string -> URI
# Use the DIRECT connection (port 5432), not the Supavisor/PgBouncer
# transaction-mode pooler (port 6543) — and use the `postgres` role, not
# `anon`/`authenticated`, since this backend enforces authorization itself
# rather than relying on RLS. Append ?sslmode=require (Supabase requires TLS).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# aistudio.google.com/apikey -> Create API key. Used server-side to call
# the Gemini API for the Sell MOTM chat's answer generation. Never expose
# this to a client or return it in any API response.
GEMINI_API_KEY=your-gemini-api-key

# platform.openai.com/api-keys -> Create new secret key. Used server-side.
# Never expose this to a client or return it in any API response.
OPENAI_API_KEY=your-openai-api-key

# --- Production deployment only (docker-compose.yml) ---
# This VPS already runs a shared host-level Caddy (/etc/caddy/Caddyfile)
# fronting ~25 other apps under b2botix.ai subdomains. This app does NOT run
# its own reverse proxy/TLS -- backend/frontend containers publish to
# localhost only (see docker-compose.yml), and a separate file,
# /etc/caddy/sites/motm-sales.caddy (from motm-sales.caddy in this repo,
# copied there -- see DEPLOY.md), routes the subdomain to them by path.

# The deployed origin, added to the backend's CORS allow-list (see
# app/config.py / app/main.py). Same-origin browser requests don't strictly
# need this, but it's a harmless safety net.
FRONTEND_ORIGIN=https://motm-sales.b2botix.ai

# Baked into the frontend's JS bundle at build time. Empty string means
# "same origin as the page" -- frontend and API share one subdomain here,
# split by path (see motm-sales.caddy), so fetch() calls resolve to e.g.
# https://motm-sales.b2botix.ai/auth/login.
VITE_API_BASE_URL=
